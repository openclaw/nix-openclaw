+// Nix store ownership can differ from the runtime uid; containment and writable
+// path checks remain discovery's responsibility before this exemption is used.
+export function isTrustedNixStorePluginRoot(params: {
+  rootDir: string;
+  env?: NodeJS.ProcessEnv;
+  realpathCache?: Map<string, string>;
+}): boolean {
+  return resolveIsNixMode(params.env) && isNixStorePluginRoot(params.rootDir, params.realpathCache);
+}
